# ─────────────────────────────────────────────────────────────────────────
# BiasharaOS — environment configuration
# Copy this file to `.env` (for local/server use) and fill in real values.
# The desktop app manages DATABASE_URL and PORT automatically and does NOT
# need this file — it's for `npm run dev`, server deployments, and Docker.
# ─────────────────────────────────────────────────────────────────────────

# Required. Postgres connection string.
# Local Postgres example:      postgresql://biashara:changeme@localhost:5432/biashara
# Hosted (e.g. Neon/Supabase):  postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://biashara:changeme@localhost:5432/biashara

# Required by the API server.
PORT=5000

# Set to "true" to run pending DB migrations automatically on server start.
# Recommended for production; for local dev, prefer `npm run db:migrate`.
# If you enable this on a built (bundled) server, MIGRATIONS_DIR must also be
# set — point it at lib/db/migrations (an absolute path is safest).
RUN_MIGRATIONS_ON_START=false
MIGRATIONS_DIR=

# Comma-separated list of allowed frontend origins for CORS, e.g.
#   CORS_ORIGINS=https://shop.example.com,https://admin.example.com
# Leave empty to allow all origins (fine for local/dev only).
CORS_ORIGINS=

# Set to "true" only when serving the API over HTTPS in production — this
# marks the session cookie Secure. Leave "false" for local HTTP/desktop use.
COOKIE_SECURE=false

# ── M-PESA (Safaricom Daraja API) ──────────────────────────────────────────
# Optional. Leave unset to use the built-in simulation (STK push "succeeds"
# automatically after a few seconds — handy for demos and development).
# Get real credentials from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example.com/api/mpesa/callback
# "sandbox" (default) or "production"
MPESA_ENV=sandbox

# ── AI Advisor (optional) ──────────────────────────────────────────────────
# Optional. Leave unset and the AI Advisor page will show a friendly notice
# instead of live responses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Frontend build (artifacts/biashara-os) ─────────────────────────────────
# Used by `npm run dev:web` only.
BASE_PATH=/
